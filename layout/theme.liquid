<!doctype html>
{% comment %}
  AuConforto Dawn Apê v1 — baseado na arquitetura Dawn OS 2.0 (v15.x)
  Tema completo PT-BR para pets em apartamento. Sem dependência de app.
{% endcomment %}
<html class="no-js" lang="{{ request.locale.iso_code | default: 'pt-BR' }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_header_bg | default: '#1f1814' }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Página {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
  {{ 'auconforto.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'auconforto.js' | asset_url }}" defer></script>

  <style>
    :root{
      --ac-bg:{{ settings.color_page_bg | default: '#f3ede4' }};
      --ac-surface:{{ settings.color_card_bg | default: '#fbf7f1' }};
      --ac-fg:{{ settings.color_text | default: '#1f1814' }};
      --ac-primary:{{ settings.color_accent | default: '#b54a2a' }};
    }
  </style>
</head>
<body class="template-{{ template.name }} page-{{ template.suffix | default: 'default' }}">
  <a class="skip-to-content-link" href="#MainContent">Pular para o conteúdo</a>

  {% comment %} Anúncio agora mora dentro do header-auconforto (evita section solta no layout) {% endcomment %}
  {% section 'header-auconforto' %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer-auconforto' %}

  {% render 'cart-drawer' %}
  {% render 'search-modal' %}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js','js');
  </script>
</body>
</html>
