{{ 'auconforto.css' | asset_url | stylesheet_tag }}

<div class="ac-announcement" {{ section.shopify_attributes }}>
  <div class="ac-announcement__track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <a
          class="ac-announcement__item"
          href="{{ block.settings.link | default: section.settings.link | default: '/collections/pets' }}"
          {{ block.shopify_attributes }}
          {% if i == 2 %}aria-hidden="true" tabindex="-1"{% endif %}
        >
          {{ block.settings.text }}
        </a>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "AC Announcement",
  "tag": "section",
  "class": "section-ac-announcement",
  "limit": 1,
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "Link padrão",
      "default": "/collections/pets"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensagem",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "url", "id": "link", "label": "Link desta mensagem" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AC Announcement",
      "blocks": [
        { "type": "message", "settings": { "text": "FRETE GRÁTIS ACIMA DE R$149 | PIX COM 5% OFF" } },
        { "type": "message", "settings": { "text": "8-15 DIAS ÚTEIS COM RASTREIO | IMPOSTO INCLUSO" } },
        { "type": "message", "settings": { "text": "CUPOM VOLTA10 = 10% OFF NA PRIMEIRA COMPRA" } }
      ]
    }
  ]
}
{% endschema %}
