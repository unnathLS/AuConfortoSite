{{ 'auconforto.css' | asset_url | stylesheet_tag }}

<section class="ac-why" {{ section.shopify_attributes }}>
  {% for block in section.blocks %}
    <article {{ block.shopify_attributes }}>
      {% if block.settings.image != blank %}
        {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
      {% endif %}
      <h3 style="font-size:1.6rem;margin:1rem 0 .5rem;">{{ block.settings.title }}</h3>
      <p style="color:#6f645a;">{{ block.settings.text }}</p>
      {% if block.settings.cta_label != blank %}
        <p><a href="{{ block.settings.cta_link }}" style="font-weight:600;color:#b54a2a;">{{ block.settings.cta_label }}</a></p>
      {% endif %}
    </article>
  {% endfor %}
</section>

{% schema %}
{
  "name": "AC Por que funciona",
  "class": "section-ac-why",
  "blocks": [
    {
      "type": "story",
      "name": "Bloco",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "text", "id": "cta_label", "label": "CTA" },
        { "type": "url", "id": "cta_link", "label": "Link do CTA" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AC Por que funciona",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "title": "5 min por dia, 80% menos pelo no sofá",
            "text": "Pente + Escova Vapor tiram o subpelo que aspirador não pega. Sem puxar, sem machucar. Gato ronrona, cachorro fica quieto.",
            "cta_label": "Quero casa sem pelo"
          }
        },
        {
          "type": "story",
          "settings": {
            "title": "Gato sozinho não precisa destruir o sofá",
            "text": "Moinho cansa em 15 min sem você. Tapete Gel alivia o calor sem molhar, sem geladeira, sem energia.",
            "cta_label": "Quero gato tranquilo"
          }
        }
      ]
    }
  ]
}
{% endschema %}
