<section class="ac-coupon" {{ section.shopify_attributes }}>
  <h2>{{ section.settings.title }}</h2>
  <p>{{ section.settings.text }}</p>
  {% form 'customer', class: 'ac-coupon__form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {% if form.errors %}<p style="color:#ffb4a2">{{ form.errors | default_errors }}</p>{% endif %}
    <input type="email" name="contact[email]" required placeholder="teu@email.com" aria-label="E-mail">
    <button type="submit" class="ac-btn ac-btn--primary">{{ section.settings.button }}</button>
    {% if form.posted_successfully? %}
      <p style="width:100%">✓ Fechado! Teu desconto de boas-vindas tá a caminho do e-mail.</p>
    {% endif %}
  {% endform %}
</section>
{% schema %}
{
  "name": "AC Cupom",
  "class": "section-ac-coupon",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Ganha 10% OFF na primeira compra" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Deixa teu e-mail e recebe teu desconto de boas-vindas + rastreio sem enrolação." },
    { "type": "text", "id": "button", "label": "Botão", "default": "Quero meu desconto" }
  ],
  "presets": [{ "name": "AC Cupom" }]
}
{% endschema %}
