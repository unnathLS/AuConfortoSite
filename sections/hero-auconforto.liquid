<section class="ac-hero" {{ section.shopify_attributes }}>
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'ac-hero__img', alt: section.settings.image.alt | default: 'Gato e cão no sofá do apê' }}
  {% else %}
    <img class="ac-hero__img" src="{{ 'hero.jpg' | asset_url }}" alt="Gato e cão no sofá do apê" loading="eager">
  {% endif %}
  <div class="ac-hero__shade"></div>
  <div class="ac-hero__inner">
    <p class="ac-kicker">{{ section.settings.kicker }}</p>
    <h1 class="ac-hero__title">{{ section.settings.title }}</h1>
    <p class="ac-hero__sub">{{ section.settings.subtitle }}</p>
    <div class="ac-hero__btns">
      {% if section.settings.btn1_label != blank %}
        <a class="ac-btn ac-btn--primary" href="{{ section.settings.btn1_link | default: '/collections/pets' }}">{{ section.settings.btn1_label }}</a>
      {% endif %}
      {% if section.settings.btn2_label != blank %}
        <a class="ac-btn ac-btn--ghost" href="{{ section.settings.btn2_link | default: '/pages/rastrear-pedido' }}">{{ section.settings.btn2_label }}</a>
      {% endif %}
    </div>
    {% if section.settings.pills != blank %}
      <p class="ac-hero__pills">✓ {{ section.settings.pills }}</p>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "AC Hero",
  "tag": "section",
  "class": "section-ac-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem (gato/cão no sofá, sem texto)" },
    { "type": "text", "id": "kicker", "label": "Linha pequena", "default": "AuConforto · pets em apartamento" },
    { "type": "textarea", "id": "title", "label": "Título", "default": "Apartamento com pet não precisa viver com pelo, calor e tédio" },
    { "type": "textarea", "id": "subtitle", "label": "Sub", "default": "4 soluções testadas pra cães e gatos em apê. Pix com desconto, rastreio incluso, 7 dias de garantia." },
    { "type": "text", "id": "btn1_label", "label": "Botão 1", "default": "Ver os 4 mais vendidos" },
    { "type": "url", "id": "btn1_link", "label": "Link botão 1", "default": "/collections/pets" },
    { "type": "text", "id": "btn2_label", "label": "Botão 2", "default": "Rastrear meu pedido" },
    { "type": "url", "id": "btn2_link", "label": "Link botão 2", "default": "/pages/rastrear-pedido" },
    { "type": "text", "id": "pills", "label": "Linha inferior", "default": "Pix com desconto · 8–15 dias úteis com rastreio · 7 dias contra defeito" }
  ],
  "presets": [{ "name": "AC Hero" }]
}
{% endschema %}
