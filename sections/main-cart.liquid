<div class="page-width" style="padding:2rem 1.5rem 3rem" {{ section.shopify_attributes }}>
  <h1>Teu carrinho</h1>
  {% if cart.item_count == 0 %}
    <p>Tá vazio por aqui. Bora resolver o pelo, o calor ou o tédio?</p>
    <p><a class="ac-btn ac-btn--primary" href="{{ routes.collections_url }}/pets">Ver os 4 mais vendidos</a></p>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      {% for item in cart.items %}
        <div style="display:flex;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--ac-border)">
          <img src="{{ item.image | image_url: width: 160 }}" alt="" style="width:80px;height:80px;object-fit:cover;border-radius:10px">
          <div style="flex:1"><strong>{{ item.product.title }}</strong><br><small>{{ item.variant.title }}</small>{% if item.product.variants.size > 1 %}<br><select onchange="if(this.value)location.href=this.value" aria-label="Trocar cor ou modelo" style="max-width:100%;min-height:38px;border-radius:8px;border:1px solid var(--ac-border);background:#fff;padding:0 .5rem;margin:.25rem 0;font-size:.85rem">{% for v in item.product.variants %}<option value="{{ routes.cart_change_url }}?line={{ forloop.parentloop.index }}&id={{ v.id }}" {% if v.id == item.variant.id %}selected{% endif %}>{{ v.title }} — {{ v.price | money }}</option>{% endfor %}</select>{% endif %}<br><span style="display:inline-flex;align-items:center;gap:.55rem;margin:.25rem 0"><a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" aria-label="Diminuir" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border-radius:8px;border:1px solid var(--ac-border);background:#fff;text-decoration:none">−</a><strong>{{ item.quantity }}</strong><a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" aria-label="Aumentar" style="width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border-radius:8px;border:1px solid var(--ac-border);background:#fff;text-decoration:none">+</a></span><br><strong>{{ item.final_line_price | money }}</strong></div>
          <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">remover</a>
        </div>
      {% endfor %}
      <p><strong>Total: {{ cart.total_price | money }}</strong></p>
      <p style="font-size:.9rem;color:var(--ac-muted)">Frete calculado no checkout · Grátis acima de R$149 · Pix + cartão 3x</p>
      <button type="submit" name="checkout" class="ac-btn ac-btn--primary">Finalizar compra</button>
    </form>
  {% endif %}
</div>
{% schema %}{ "name": "AC Carrinho", "settings": [], "presets": [{ "name": "AC Carrinho" }] }{% endschema %}
