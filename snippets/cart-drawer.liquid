<div class="ac-overlay" id="AcOverlay" data-close-cart></div>
<aside class="ac-drawer" id="AcCartDrawer" aria-label="Carrinho">
  <div class="ac-drawer__head"><strong>Teu carrinho (<span class="ac-cart-count">{{ cart.item_count }}</span>)</strong><button class="ac-icon-btn" data-close-cart>✕</button></div>
  <div class="ac-drawer__body">
    <p id="AcFreeMsg" style="font-size:.88rem;font-weight:700;margin:0"></p>
    <div class="ac-freebar"><i id="AcFreeBar" style="width:0"></i></div>
    <div id="AcCartItems"><p>Carregando…</p></div>
  </div>
  <div class="ac-drawer__foot">
    <p style="display:flex;justify-content:space-between"><span>Total</span><strong id="AcCartTotal">{{ cart.total_price | money }}</strong></p>
    <a href="/checkout" class="ac-btn ac-btn--primary" style="width:100%">Finalizar compra</a>
    <p style="text-align:center;font-size:.82rem;color:var(--ac-muted)">Pix + cartão 3x · Frete grátis +R$149 · 7 dias de garantia</p>
    <p style="text-align:center"><a href="{{ routes.collections_url }}/pets">Ver os 4 mais vendidos</a></p>
  </div>
</aside>
<script>window.AcStrings = { empty: "Tá vazio por aqui. Bora resolver o pelo, o calor ou o tédio?", free_done: "Tu ganhou FRETE GRÁTIS 🎉" };</script>
